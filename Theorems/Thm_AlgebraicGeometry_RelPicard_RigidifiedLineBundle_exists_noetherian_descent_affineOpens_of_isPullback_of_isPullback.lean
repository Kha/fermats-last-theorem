    (M : RigidifiedLineBundle f (L.one (𝟙 (Spec (CommRingCat.of R)))) g) (U : X.affineOpens)
    (S₁ : Subalgebra ℤ R) (hS₁ : S₁.FG)
    (A₁ : Scheme.{0}) (f₁ : A₁ ⟶ Spec (CommRingCat.of ↥S₁)) (L₁ : RelativeGroupLaw ↥S₁ f₁) (hA₁ : AbelianSchemePropertyBundle ↥S₁ f₁)
