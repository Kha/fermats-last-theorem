    (h₀ : FakeEllipticCurve.IsIsogenyPair (r ^ d) E₀ A₀ φ₀ φ₀')
    (hred : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S₀)) (P : SchemeHomOver t E₀.f),
