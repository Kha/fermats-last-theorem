      (∀ x : AlgebraicClosure ℚ, τ' x = τ x) →
      ∀ z : 𝒢.Points (AlgebraicClosure ℚ), Δ (τ' • z) = τ • Δ z) :
    ∀ x : ModularCurve.JH M H, x ∈ O.finPts p →
      (∀ σ ∈ Pl.inertiaSubgroupIn ℚ, ∀ c : ℕ,
