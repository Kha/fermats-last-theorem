            (∀ i, ∃ g h, NumberField.TateGlobal.IsFactorizableStandardOutside (Φc i) S g h) ∧
            Φ = fun x => ∏ i, Φc i (x i)) ∧
          (∀ x, 0 ≤ (Φ x).re ∧ (Φ x).im = 0) ∧
