    (φ ψ : F →ₐ[K] F') (hφ : φ.toRingHom.IsIntegral) (hψ : ψ.toRingHom.IsIntegral)
    (hfφ : FiniteAlong K φ) (hfψ : FiniteAlong K ψ)
    (W : F' ≃ₐ[K] F') (τ₁ τ₂ : F ≃ₐ[K] F)
    (hWφ : ∀ x : F, W (φ x) = ψ (τ₁ x)) (hWψ : ∀ x : F, W (ψ x) = φ (τ₂ x))
