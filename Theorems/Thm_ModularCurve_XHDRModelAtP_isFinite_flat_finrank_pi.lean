theorem ModularCurve.XHDRModelAtP.isFinite_flat_finrank_pi
    (p M : ℕ) [Fact p.Prime] [NeZero M] (H : Subgroup (ZMod M)ˣ) (hpM : p ∣ M) (hpM2 : ¬ p ^ 2 ∣ M)
    (hHp : ∀ u : (ZMod M)ˣ, ZMod.unitsMap (Nat.div_dvd_of_dvd hpM) u = 1 → u ∈ H) [NeZero (M / p)]
    (hj : jqModC ℚ ∈ qExpFunctionFieldC ℚ (⊤ : Subgroup SL(2, ℤ)))
    (𝔛 : XHDRModelAtP p M H hpM hj) :
    ∃ (_ : IsFinite 𝔛.π.1) (_ : LocallyOfFinitePresentation 𝔛.π.1), Flat 𝔛.π.1 ∧
      ∀ x : ↥(X p (ΓN p M H hpM) hj), 𝔛.π.1.finrank x = p + 1 := by p2m_exact_reverting @_root_.P2MW.S_ModularCurve_XHDRModelAtP_isFinite_flat_finrank_pi.solution
