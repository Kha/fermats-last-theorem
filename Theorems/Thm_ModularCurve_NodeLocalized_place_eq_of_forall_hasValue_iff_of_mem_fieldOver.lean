theorem ModularCurve.NodeLocalized.place_eq_of_forall_hasValue_iff_of_mem_fieldOver
    {q : ℕ} [Fact q.Prime]
    (K : IntermediateField ℚ (AlgebraicClosure ℚ)) [FiniteDimensional ℚ K]
    (W₁ W₂ : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar (1 * q)))
    (heq : ∀ g : ↥(modularFunctionFieldBar (1 * q)),
      (g : LaurentSeries (AlgebraicClosure ℚ)) ∈ fieldOver (1 * q) K →
      ∀ c₀ : AlgebraicClosure ℚ, W₁.HasValue g c₀ ↔ W₂.HasValue g c₀) :
    W₁ = W₂ := by p2m_exact_reverting @_root_.P2MW.S_ModularCurve_NodeLocalized_place_eq_of_forall_hasValue_iff_of_mem_fieldOver.solution
