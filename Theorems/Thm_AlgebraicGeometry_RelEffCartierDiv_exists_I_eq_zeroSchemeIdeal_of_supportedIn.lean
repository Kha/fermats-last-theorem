        ∃ e : M ≅ D.lineBundle, s ≫ e.hom = D.I.invModuleSection := by p2m_exact_reverting @_root_.P2MW.S_AlgebraicGeometry_RelEffCartierDiv_exists_I_eq_zeroSchemeIdeal_of_supportedIn.solution
