    Ideal.map (Φ.comp (Scheme.ΓSpecIso (CommRingCat.of (OriginChartRing W))).hom.hom)
      (((torsionIdeal G q).comap (originChartι W ≫ toPullbackId)).ideal ⟨⊤, AlgebraicGeometry.isAffineOpen_top _⟩) =
