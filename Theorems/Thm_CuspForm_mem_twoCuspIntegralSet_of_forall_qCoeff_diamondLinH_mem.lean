theorem CuspForm.mem_twoCuspIntegralSet_of_forall_qCoeff_diamondLinH_mem
    (p : ℕ) [Fact p.Prime] (M : ℕ) [NeZero M] (hpM : p ∣ M) (hpM2 : ¬ p ^ 2 ∣ M)
    (H : Subgroup (ZMod M)ˣ)
    (hHp : ∀ u : (ZMod M)ˣ, ZMod.unitsMap (Nat.div_dvd_of_dvd hpM) u = 1 → u ∈ H)
    (h : CuspForm (CohCarrier.GammaH M H) 2)
    (hS : ∀ (d : (ZMod M)ˣ) (W' : ModularForm.AtkinLehnerDatum M p) (n : ℕ),
        ModularFormClass.qCoeff (⇑(CuspForm.diamondLinH 2 d h)) n ∈ (⊥ : Subring ℂ) ∧
          ModularFormClass.qCoeff (ModularForm.alSlash W' 2 ⇑(CuspForm.diamondLinH 2 d h)) n ∈ (⊥ : Subring ℂ)) :
    h ∈ CuspForm.twoCuspIntegralSet M H 2 p (⊥ : Subring ℂ) := by p2m_exact_reverting @_root_.P2MW.S_CuspForm_mem_twoCuspIntegralSet_of_forall_qCoeff_diamondLinH_mem.solution
