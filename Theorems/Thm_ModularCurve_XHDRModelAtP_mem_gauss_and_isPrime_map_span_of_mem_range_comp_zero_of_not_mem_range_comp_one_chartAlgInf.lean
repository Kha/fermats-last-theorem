    (W₀ : ValuationSubring ↥(qExpFunctionFieldC ℚ (ΓM M H)))
    (hW₀ : (∀ f₀ : ↥(qExpFunctionFieldC ℚ (ΓM M H)), f₀ ∈ W₀ ↔
