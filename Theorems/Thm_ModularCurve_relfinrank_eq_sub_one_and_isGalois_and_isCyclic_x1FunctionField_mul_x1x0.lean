theorem ModularCurve.relfinrank_eq_sub_one_and_isGalois_and_isCyclic_x1FunctionField_mul_x1x0
    (p : ℕ) [Fact p.Prime] (M : ℕ) [NeZero M] (hM : 5 ≤ M) (hpM : ¬ p ∣ M)
    (L : Type) [Field L] [CharZero L]
    (K : IntermediateField L (LaurentSeries L))
    (hK : K = ModularCurve.laurentBaseChange L (ModularCurve.x1FunctionField (M * p)))
    (K₁ : IntermediateField L (LaurentSeries L))
    (hK₁ : K₁ = ModularCurve.laurentBaseChange L (ModularCurve.x1x0FunctionFieldC ℚ M p))
    (hle : K₁ ≤ K) :
    IntermediateField.relfinrank K₁ K = p - 1 ∧
      IsGalois ↥K₁ ↥(IntermediateField.extendScalars hle) ∧
      IsCyclic (↥(IntermediateField.extendScalars hle) ≃ₐ[↥K₁] ↥(IntermediateField.extendScalars hle)) := by p2m_exact_reverting @_root_.P2MW.S_ModularCurve_relfinrank_eq_sub_one_and_isGalois_and_isCyclic_x1FunctionField_mul_x1x0.solution
