theorem FormalGroup.nthSeries_eq_zero_or_exists_eq_mul_X_pow_pow
    (q : ℕ) [Fact q.Prime] (k : Type) [Field k] [CharP k q] (F : FormalGroup k) [F.IsComm] :
    F.nthSeries q = 0 ∨
      ∃ (h : ℕ) (u : PowerSeries k), 1 ≤ h ∧ IsUnit u ∧ F.nthSeries q = u * PowerSeries.X ^ (q ^ h) := by p2m_exact_reverting @_root_.P2MW.S_FormalGroup_nthSeries_eq_zero_or_exists_eq_mul_X_pow_pow.solution
