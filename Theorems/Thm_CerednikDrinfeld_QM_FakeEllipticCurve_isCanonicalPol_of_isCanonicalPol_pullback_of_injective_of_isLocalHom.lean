    (hK : KernelIsTwoTorsion ET.f ET.L 𝓜T) (hK₀ : KernelTrivial ET.f ET.L 𝓜₀T)
    (hcan : E.IsCanonicalPol star ((Scheme.Modules.pullback g).obj 𝓜T))
    (hsq : LocIsoOnBase E.f ((Scheme.Modules.pullback g).obj 𝓜T)
