theorem bijective_algebraMap_sections_baseChange (N₀ q : ℕ) [NeZero N₀] [Fact q.Prime] (hqN : ¬ q ∣ N₀) (𝔓 : DRModelPackageLevel N₀ q hqN) :
    ∀ (A : Type) [CommRing A] [Algebra (R q) A],
      letI := Scheme.TwoAffineOpenCover.algebraOfHom
        (Limits.pullback.snd (toBase N₀ q) (Scheme.TwoAffineOpenCover.specMap (R q) A)) ⊤
      Function.Bijective (algebraMap A Γ(Limits.pullback (toBase N₀ q) (Scheme.TwoAffineOpenCover.specMap (R q) A), ⊤)) := by p2m_exact_reverting @_root_.P2MW.S_ModularCurve_DRModelPackageLevel_bijective_algebraMap_sections_baseChange.solution

