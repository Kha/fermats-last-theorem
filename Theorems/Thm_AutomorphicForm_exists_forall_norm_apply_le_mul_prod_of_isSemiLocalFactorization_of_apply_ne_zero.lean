                ℂˣ) : ℂ)‖ ^ js v) := by p2m_exact_reverting @_root_.P2MW.S_AutomorphicForm_exists_forall_norm_apply_le_mul_prod_of_isSemiLocalFactorization_of_apply_ne_zero.solution
