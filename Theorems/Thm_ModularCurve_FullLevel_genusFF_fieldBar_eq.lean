theorem ModularCurve.FullLevel.genusFF_fieldBar_eq
    (q : ℕ) [Fact q.Prime] (hq : 5 ≤ q) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M') :
    (AlgebraicCurve.genusFF (AlgebraicClosure ℚ) ↥(fieldBar q M') : ℚ) =
      1 + (q : ℚ) * ((q : ℚ) ^ 2 - 1) * dedekindPsi M' / 24 -
        ((q : ℚ) ^ 2 - 1) * ((∑ d ∈ M'.divisors, Nat.totient (Nat.gcd d (M' / d)) : ℕ) : ℚ) / 4 := by p2m_exact_reverting @_root_.P2MW.S_ModularCurve_FullLevel_genusFF_fieldBar_eq.solution
