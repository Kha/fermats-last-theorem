    (N : ℕ) (hN : (N : κ) ≠ 0) (t q : ℤ)
    (hchar : γ.comp γ + ((N : ℤ) ^ 2 * q) • AddMonoidHom.id _ = ((N : ℤ) * t) • γ) :
    ∃ (W : WeierstrassCurve κ) (_ : W.IsElliptic)
