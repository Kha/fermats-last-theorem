            comp x = 0 → comp ⟨φ • (x : JZero (N * q)), hx⟩ = 0) := by p2m_exact_reverting @_root_.P2MW.S_ModularCurve_PlaceSpecialization_componentMap_frobenius_smul_eq_zero_of_eq_zero.solution
