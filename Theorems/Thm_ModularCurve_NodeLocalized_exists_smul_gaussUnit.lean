theorem ModularCurve.NodeLocalized.exists_smul_gaussUnit
    {q : ℕ} [Fact q.Prime] {A : ValuationSubring (AlgebraicClosure ℚ)}
    {k : Type*} [Field k] [CharP k q] (red : A →+* k)
    (hker : ∀ c : A, red c = 0 ↔ c ∈ IsLocalRing.maximalIdeal A)
    (f : ↥(modularFunctionFieldBar (1 * q))) (hf : f ≠ 0) :
    ∃ (c : AlgebraicClosure ℚ) (_ : c ≠ 0)
      (h : ((c • f : modularFunctionFieldBar (1 * q)) : LaurentSeries (AlgebraicClosure ℚ)) ∈
        CharPReduction.modularLocalized (1 * q) A.toSubring red),
      CharPReduction.modularRedLocHom (1 * q) A.toSubring red ⟨_, h⟩ ≠ 0 := by p2m_exact_reverting @_root_.P2MW.S_ModularCurve_NodeLocalized_exists_smul_gaussUnit.solution
