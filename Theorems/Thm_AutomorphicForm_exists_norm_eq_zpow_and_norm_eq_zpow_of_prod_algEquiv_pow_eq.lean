theorem AutomorphicForm.exists_norm_eq_zpow_and_norm_eq_zpow_of_prod_algEquiv_pow_eq
    (K L : Type) [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    (v : HeightOneSpectrum (𝓞 K)) (w : v.Extension (𝓞 L))
    (hw : Ideal.ramificationIdx' (HeightOneSpectrum.under (𝓞 K) w.1).asIdeal w.1.asIdeal = 1)
    (θ : w.1.adicCompletion L ≃ₐ[v.adicCompletion K] w.1.adicCompletion L)
    (α : (w.1.adicCompletion L)ˣ) (a : (v.adicCompletion K)ˣ)
    (hNα : ∏ i ∈ Finset.range (Module.finrank (v.adicCompletion K) (w.1.adicCompletion L)),
        (θ ^ i) (α : w.1.adicCompletion L) = algebraMap (v.adicCompletion K) (w.1.adicCompletion L) a) :
    ∃ r : ℤ, ‖(α : w.1.adicCompletion L)‖ = (Ideal.absNorm w.1.asIdeal : ℝ) ^ (-r) ∧
      ‖(a : v.adicCompletion K)‖ =
        (Ideal.absNorm v.asIdeal : ℝ) ^ (-((Module.finrank (v.adicCompletion K) (w.1.adicCompletion L) : ℤ) * r)) := by p2m_exact_reverting @_root_.P2MW.S_AutomorphicForm_exists_norm_eq_zpow_and_norm_eq_zpow_of_prod_algEquiv_pow_eq.solution
