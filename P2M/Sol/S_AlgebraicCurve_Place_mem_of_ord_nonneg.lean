theorem solution {K F : Type*} [Field K] [Field F] [Algebra K F] (v : Place K F) {f : F} (hf : f ≠ 0) (h : 0 ≤ v.ord f) :
    f ∈ v.toValuationSubring :=
  AlgebraicCurve.Place.rowMain v hf h
end S_AlgebraicCurve_Place_mem_of_ord_nonneg
