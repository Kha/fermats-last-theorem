open AlgebraicCurve ModularCurve

theorem solution (N : ℕ) [NeZero N] :
    Infinite (Place (AlgebraicClosure ℚ) (modularFunctionFieldBar N)) := by
  classical
  by_contra hfin
  haveI : Fintype (Place (AlgebraicClosure ℚ) (modularFunctionFieldBar N)) := fintypeOfNotInfinite hfin
  haveI : Algebra.IsAlgebraic ℚ (AlgebraicClosure ℚ) := AlgebraicClosure.isAlgebraic ℚ
  let σ : AlgebraicClosure ℚ →+* ℂ :=
    (IsAlgClosed.lift (R := ℚ) (M := ℂ) (S := AlgebraicClosure ℚ)).toRingHom
  obtain ⟨v, hv, -⟩ := exists_seq_place_tendsto_evalAt_cuspInftyBar N σ Finset.univ ∅ (by simp)
  exact hv 0 (Finset.mem_univ _)
